    "typescript": "catalog:"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-fastify": "catalog:",
    "@fastify/cors": "catalog:",
    "@poky/api": "workspace:*",
    "@poky/auth": "workspace:*",
    "@poky/db": "workspace:*",
    "@poky/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "zod": "catalog:"
  }
}
