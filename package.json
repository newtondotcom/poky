{
  "name": "poky",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "better-auth": "^1.4.18",
      "@better-auth/expo": "^1.4.18",
      "dotenv": "^17.2.4",
      "zod": "^4.3.6",
      "typescript": "^5.9.3",
      "tsdown": "^0.20.3",
      "drizzle-orm": "^0.45.0"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "compile:server": "turbo -F backend compile",
    "db:push": "turbo -F @poky/db db:push",
    "db:studio": "turbo -F @poky/db db:studio",
    "db:generate": "turbo -F @poky/db db:generate",
    "db:migrate": "turbo -F @poky/db db:migrate"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "oxfmt": "^0.30.0",
    "oxlint": "^1.45.0",
    "tsdown": "^0.20.3",
    "turbo": "^2.8.4"
  },
  "packageManager": "bun@1.3.1"
}
