{
  "name": "poky",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "better-auth": "^1.6.26",
      "@better-auth/expo": "^1.6.26",
      "dotenv": "^17.2.4",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "tsdown": "^0.21.10",
      "drizzle-orm": "^0.45.2",
      "@bufbuild/protobuf": "^2.13.0",
      "@bufbuild/buf": "^1.72.0",
      "@connectrpc/connect": "^2.1.2",
      "@connectrpc/connect-fastify": "^2.1.2",
      "@connectrpc/connect-query": "^2.3.1",
      "@connectrpc/connect-web": "^2.1.2",
      "@connectrpc/validate": "^0.2.0",
      "drizzle-kit": "^0.31.10",
      "@types/bun": "^1.3.14",
      "fastify": "^5.11.3",
      "@fastify/cors": "^11.3.0",
      "winston": "^3.19.0",
      "@nats-io/transport-node": "^3.3.1",
      "web-push": "^3.6.7",
      "@types/web-push": "^3.6.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @poky/db db:push",
    "db:studio": "turbo -F @poky/db db:studio",
    "db:generate": "turbo -F @poky/db db:generate",
    "db:migrate": "turbo -F @poky/db db:migrate",
    "check": "oxlint && oxfmt --write",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "compile:server": "turbo -F server compile"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@poky/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@poky/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.7"
}
