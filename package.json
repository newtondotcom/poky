{
  "name": "poky",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "better-auth": "^1.4.18",
      "@better-auth/expo": "^1.4.18",
      "dotenv": "^17.2.4",
      "zod": "^4.3.6",
      "typescript": "^5",
      "tsdown": "^0.21.7",
      "drizzle-orm": "^0.45.0",
      "@bufbuild/protobuf": "^2.11.0",
      "@bufbuild/buf": "^1.65.0",
      "@connectrpc/connect": "^2.1.1",
      "@connectrpc/connect-fastify": "^2.1.1",
      "@connectrpc/connect-query": "^2.2.0",
      "@connectrpc/connect-web": "^2.1.1",
      "@connectrpc/validate": "^0.2.0",
      "drizzle-kit": "^0.31.9",
      "pg": "^8.18.0",
      "@types/pg": "^8.16.0",
      "@types/bun": "^1.3.4",
      "fastify": "^5.7.4",
      "@fastify/cors": "^11.2.0",
      "winston": "^3.19.0",
      "ioredis": "^5.9.2",
      "@nats-io/transport-node": "^3.3.1",
      "postgres": "^3.4.8",
      "web-push": "^3.6.7",
      "@types/web-push": "^3.6.4"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @poky/db db:push",
    "db:studio": "turbo -F @poky/db db:studio",
    "db:generate": "turbo -F @poky/db db:generate",
    "db:migrate": "turbo -F @poky/db db:migrate",
    "check": "oxlint && oxfmt --write",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "compile:server": "turbo -F server compile"
  },
  "dependencies": {
    "@poky/env": "workspace:*",
    "dotenv": "^17.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@poky/config": "workspace:*",
    "@types/bun": "^1.3.12",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.7"
}
